# Kafka Cluster Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_PRODUCER_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=aikyam-vision-v1
KAFKA_AUTO_OFFSET_RESET=latest
POST_CREATED_TOPIC=social.post.created
VISION_SCORES_TOPIC=aikyam.vision.scores

# Vector Database (Qdrant) Configuration
AIKYAM_QDRANT_URL=http://localhost:6333
AIKYAM_QDRANT_COLLECTION=aikyam_vision_media
AIKYAM_QDRANT_CONSUMER_GROUP=aikyam-qdrant-indexer-v1

# External Services & CDN Configuration
SIMCLUSTERS_BASE_URL=http://host.docker.internal:8080
MEDIA_SERVICE_URL=http://aikyam-media-control-plane:8080
AIKYAM_CDN_BASE_URL=https://cdn.shriaikyam.com/media
AIKYAM_HTTP_TIMEOUT_SECONDS=10

# AI Models & Processing Configuration
AIKYAM_CLIP_MODEL_ENABLED=true
AIKYAM_CLIP_MODEL_NAME=openai/clip-vit-base-patch32
AIKYAM_CLIP_SCORE_THRESHOLD=0.005
AIKYAM_CLIP_TOP_K=10
AIKYAM_WHISPER_MODEL_ENABLED=false
AIKYAM_WHISPER_MODEL_SIZE=base
AIKYAM_VIDEO_FRAME_COUNT=5
